[Unit]
Description=Run GoViral Prompt Command Center every 6 minutes (staggered)

[Timer]
# Boot: 9 minutes (staggered after router at 7min)
OnBootSec=9min
# Interval: 6 minutes (was 3 min)
OnUnitActiveSec=6min
AccuracySec=30s
# Randomized delay prevents alignment with other timers
RandomizedDelaySec=30
# Persistent=false: do NOT catch up missed runs after reboot/sleep.
# Prevents catch-up storms where systemd fires multiple triggers at once.
Persistent=false

[Install]
WantedBy=timers.target
