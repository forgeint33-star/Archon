#!/usr/bin/env python3
"""GoViral daily operations digest for Telegram.

Sends a comprehensive daily summary including doctor status, approval counts,
active services, backup freshness, incident summary, agent runs, and latest PRD.

Credentials: /etc/goviral/credentials/telegram-bot-token and telegram-chat-id
"""
import json
import os
import pwd
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

CRED_DIR = Path('/etc/goviral/credentials')
TOKEN_FILE = CRED_DIR / 'telegram-bot-token'
CHAT_FILE = CRED_DIR / 'telegram-chat-id'
STATE_DIR = Path('/var/lib/goviral-archon/.archon/notifications')
DIGEST_STATE = STATE_DIR / 'daily-digest-state.json'
HEALTH_FILE = Path('/var/lib/goviral-archon/.archon/goviral-control-health.json')
BACKUP_LATEST = Path('/var/lib/goviral-archon/backups/control-plane/latest.tar.gz')
QUEUE_FILE = Path('/var/lib/goviral-archon/workspaces/goviral-brain/.governance/approval/queue.json')
UPGRADE_DIR = Path('/var/lib/goviral-archon/.archon/upgrade-checks')
RESTORE_DIR = Path('/var/lib/goviral-archon/.archon/restore-drills')

API_BASE = 'http://127.0.0.1:8180'
TIMEOUT = 15
MAX_MESSAGE_LENGTH = 4000


def now() -> str:
    return datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')


def load_credentials() -> tuple[str, str] | None:
    try:
        token = TOKEN_FILE.read_text().strip()
        chat_id = CHAT_FILE.read_text().strip()
        if token and chat_id:
            return token, chat_id
    except (OSError, PermissionError):
        pass
    return None


def send_telegram(token: str, chat_id: str, text: str) -> bool:
    truncated = text[:MAX_MESSAGE_LENGTH]
    url = f'https://api.telegram.org/bot{token}/sendMessage'
    data = json.dumps({
        'chat_id': chat_id,
        'text': truncated,
        'parse_mode': 'HTML',
    }).encode()
    request = urllib.request.Request(
        url, data=data,
        headers={'Content-Type': 'application/json'},
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            result = json.load(response)
            return result.get('ok', False)
    except (urllib.error.URLError, urllib.error.HTTPError, OSError, json.JSONDecodeError):
        return False


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + '\n')
    os.chmod(path, 0o600)
    try:
        account = pwd.getpwnam('goviral-archon')
        os.chown(path, account.pw_uid, account.pw_gid)
    except (KeyError, PermissionError):
        pass


def api_get(endpoint: str) -> dict:
    try:
        url = f'{API_BASE}{endpoint}'
        with urllib.request.urlopen(url, timeout=TIMEOUT) as response:
            return json.load(response)
    except Exception:
        return {}


def backup_age_hours() -> float | None:
    try:
        target = BACKUP_LATEST.resolve()
        age = (datetime.now(timezone.utc).timestamp() - target.stat().st_mtime) / 3600
        return round(age, 1)
    except OSError:
        return None


def latest_file_in(directory: Path) -> dict:
    try:
        files = sorted(directory.glob('*.json'), key=lambda p: p.stat().st_mtime, reverse=True)
        if files:
            return json.loads(files[0].read_text())
    except (OSError, json.JSONDecodeError):
        pass
    return {}


def failed_units() -> list[str]:
    try:
        result = subprocess.run(
            ['/usr/bin/systemctl', 'list-units', '--state=failed', '--no-legend', '--no-pager', '--plain'],
            capture_output=True, text=True, check=False, timeout=15,
        )
        return [
            line.split()[0]
            for line in result.stdout.splitlines()
            if line.strip().startswith('goviral-')
        ]
    except Exception:
        return []


def build_digest() -> str:
    """Build the daily digest message."""
    health = load_json(HEALTH_FILE)
    health_status = health.get('status', 'UNKNOWN')
    overview = api_get('/api/goviral/overview')
    incidents = api_get('/api/goviral/incidents')
    agents = api_get('/api/goviral/agents')

    queue = load_json(QUEUE_FILE)
    pending = len(queue.get('pending', []))
    approved = len(queue.get('approved', []))
    executed = len(queue.get('executed', []))

    backup_hours = backup_age_hours()
    failed = failed_units()

    upgrade = latest_file_in(UPGRADE_DIR)
    drill = latest_file_in(RESTORE_DIR)

    doctor_status = overview.get('doctor', {}).get('status', 'UNKNOWN')
    prd_title = overview.get('latest_prd', {})
    prd_name = prd_title.get('title', '—') if prd_title else '—'

    incident_list = incidents.get('incidents', [])
    critical_count = sum(1 for i in incident_list if i.get('severity') == 'critical')
    high_count = sum(1 for i in incident_list if i.get('severity') == 'high')
    warning_count = sum(1 for i in incident_list if i.get('severity') == 'warning')

    agent_summary = agents.get('summary', {})
    agent_registered = agent_summary.get('registered_count', agent_summary.get('total', 0))
    agent_enabled = agent_summary.get('enabled_count', 0)
    agent_active = agent_summary.get('active_run_count', agent_summary.get('active', 0))
    agent_runs_today = agent_summary.get('runs_today_count', 0)

    # Find last run timestamp from the runs list
    runs_list = agents.get('runs', agents.get('active_runs', []))
    last_run = '—'
    if runs_list:
        last_modified = runs_list[0].get('modified_at') if runs_list else None
        if last_modified:
            last_run = last_modified[:16].replace('T', ' ')

    lines = [
        '📊 <b>GoViral Daily Operations Report</b>',
        f'<i>{now()}</i>',
        '',
        f'<b>Health:</b> {health_status}',
        f'<b>Doctor:</b> {doctor_status}',
        '',
        '<b>Approvals:</b>',
        f'  Pending: {pending}  Approved: {approved}  Executed: {executed}',
        '',
        '<b>Incidents:</b>',
        f'  Critical: {critical_count}  High: {high_count}  Warning: {warning_count}',
    ]

    if failed:
        lines.append('')
        lines.append(f'<b>Failed Units:</b> {", ".join(failed[:5])}')

    lines.extend([
        '',
        '<b>Backup:</b>',
        f'  Latest: {f"{backup_hours}h ago" if backup_hours is not None else "none"}',
        f'  Restore drill: {drill.get("status", "not run")}',
        '',
        '<b>Agents:</b>',
        f'  Registered: {agent_registered}',
        f'  Enabled: {agent_enabled}',
        f'  Active now: {agent_active}',
        f'  Runs today: {agent_runs_today}',
        f'  Last run: {last_run}',
        '',
        f'<b>Upgrade check:</b> {upgrade.get("status", "not run")}',
        f'<b>Latest PRD:</b> {prd_name}',
    ])

    return '\n'.join(lines)


def main() -> None:
    creds = load_credentials()
    if creds is None:
        print('daily_digest=not_configured')
        return

    token, chat_id = creds
    digest = build_digest()
    success = send_telegram(token, chat_id, digest)

    save_json(DIGEST_STATE, {
        'last_sent': now(),
        'success': success,
    })

    print(f'daily_digest={"sent" if success else "failed"}')


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(f'daily_digest=error detail={str(exc)[:200]}', file=sys.stderr)
        raise SystemExit(1)
