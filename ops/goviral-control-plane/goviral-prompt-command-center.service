[Unit]
Description=GoViral Prompt Command Center
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/goviral-archon/workspaces/goviral-brain
ExecStart=/usr/local/bin/goviral-prompt-command-center-guard run-all --write
User=root

# ── Hardening ────────────────────────────────────────────────────────────────
# Prompt command center processes the full queue; 10 minutes is generous.
RuntimeMaxSec=600
TimeoutStartSec=120

# Lower scheduling priority for batch work (nice 10, idle I/O)
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
