#!/usr/bin/env python3
"""Secure Telegram credential configuration for GoViral Control Plane.

Must be run as root. Prompts for token and chat ID without echoing secrets.
Validates the bot token via getMe and sends a test message to confirm the chat.
Stores credentials as root-owned 0600 files under /etc/goviral/credentials/.
"""
import getpass
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

CRED_DIR = Path('/etc/goviral/credentials')
TOKEN_FILE = CRED_DIR / 'telegram-bot-token'
CHAT_FILE = CRED_DIR / 'telegram-chat-id'
TIMEOUT = 15


def fail(message: str) -> None:
    print(f'ERROR: {message}', file=sys.stderr)
    raise SystemExit(1)


def telegram_api(token: str, method: str, data: dict | None = None) -> dict:
    url = f'https://api.telegram.org/bot{token}/{method}'
    body = json.dumps(data).encode() if data else None
    request = urllib.request.Request(
        url,
        data=body,
        headers={'Content-Type': 'application/json'} if body else {},
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            result = json.load(response)
            if not result.get('ok'):
                fail(f'Telegram API returned ok=false for {method}')
            return result
    except urllib.error.HTTPError as exc:
        fail(f'Telegram API {method} returned HTTP {exc.code}')
    except urllib.error.URLError as exc:
        fail(f'Telegram API {method} network error: {exc.reason}')
    return {}


def main() -> None:
    if os.geteuid() != 0:
        fail('This command must be run as root.')

    print('GoViral Telegram Configuration')
    print('=' * 40)
    print()
    print('This will configure Telegram notifications for the GoViral Control Plane.')
    print('The bot token and chat ID will be stored as root-owned credential files.')
    print()

    token = getpass.getpass('Telegram bot token (hidden): ').strip()
    if not token or len(token) < 20:
        fail('Token is too short or empty.')

    print('Validating bot token...')
    me_result = telegram_api(token, 'getMe')
    bot_info = me_result.get('result', {})
    bot_name = bot_info.get('username', 'unknown')
    print(f'Bot validated: @{bot_name}')
    print()

    chat_id = input('Telegram chat ID (group or user): ').strip()
    if not chat_id:
        fail('Chat ID is empty.')

    # Validate chat by sending a test message
    print('Sending test message to validate chat...')
    test_text = (
        'GoViral Control Plane: Telegram integration configured successfully.\n'
        f'Bot: @{bot_name}\n'
        'This is a one-time setup confirmation.'
    )
    telegram_api(token, 'sendMessage', {
        'chat_id': chat_id,
        'text': test_text,
        'parse_mode': 'HTML',
    })
    print('Test message sent successfully.')
    print()

    # Store credentials
    CRED_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CRED_DIR, 0o700)
    os.chown(CRED_DIR, 0, 0)

    TOKEN_FILE.write_text(token + '\n')
    os.chmod(TOKEN_FILE, 0o600)
    os.chown(TOKEN_FILE, 0, 0)

    CHAT_FILE.write_text(chat_id + '\n')
    os.chmod(CHAT_FILE, 0o600)
    os.chown(CHAT_FILE, 0, 0)

    print('Credentials stored:')
    print(f'  {TOKEN_FILE} (root:root 0600)')
    print(f'  {CHAT_FILE} (root:root 0600)')
    print()
    print('Enable the notification timer:')
    print('  systemctl enable --now goviral-telegram-notifier.timer')
    print('  systemctl enable --now goviral-daily-ops-report.timer')


if __name__ == '__main__':
    main()
