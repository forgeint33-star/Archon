[Unit]
Description=Run GoViral Prompt-to-PRD Autonomous Brain Workflow every 12 minutes (staggered)

[Timer]
# Boot: 12 minutes (staggered well after other timers)
OnBootSec=12min
# Interval: 12 minutes (was 5 min — heaviest workflow, needs breathing room)
OnUnitActiveSec=12min
AccuracySec=30s
# Randomized delay prevents alignment
RandomizedDelaySec=45
# Persistent=false: do NOT catch up missed runs after reboot/sleep.
Persistent=false

[Install]
WantedBy=timers.target
