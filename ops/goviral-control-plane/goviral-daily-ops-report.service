[Unit]
Description=GoViral daily operations digest via Telegram
After=network-online.target goviral-archon.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/goviral-daily-ops-report
# For Type=oneshot, only TimeoutStartSec acts as the execution bound.
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/etc/goviral/credentials
ReadOnlyPaths=/var/lib/goviral-archon/.archon
ReadOnlyPaths=/var/lib/goviral-archon/backups/control-plane
ReadOnlyPaths=/var/lib/goviral-archon/workspaces/goviral-brain
ReadWritePaths=/var/lib/goviral-archon/.archon/notifications
