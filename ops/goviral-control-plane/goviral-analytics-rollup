#!/usr/bin/env python3
"""GoViral analytics rollup service.

Collects bounded operational metrics and stores compact rollup files.
Rollups are stored as timestamped JSON under .archon/analytics/.
Old rollups beyond 90 days are pruned.
"""
import json
import os
import pwd
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path('/var/lib/goviral-archon/.archon')
ANALYTICS_DIR = STATE_DIR / 'analytics'
QUEUE_FILE = Path('/var/lib/goviral-archon/workspaces/goviral-brain/.governance/approval/queue.json')
HEALTH_FILE = STATE_DIR / 'goviral-control-health.json'
BACKUP_DIR = Path('/var/lib/goviral-archon/backups/control-plane')
API_BASE = 'http://127.0.0.1:8180'
TIMEOUT = 15
MAX_ROLLUPS = 400
RETENTION_DAYS = 90


def now() -> str:
    return datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z')


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def api_get(endpoint: str) -> dict:
    try:
        with urllib.request.urlopen(f'{API_BASE}{endpoint}', timeout=TIMEOUT) as response:
            return json.load(response)
    except Exception:
        return {}


def save_rollup(data: dict) -> None:
    ANALYTICS_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    rollup_file = ANALYTICS_DIR / f'{stamp}.json'
    rollup_file.write_text(json.dumps(data, indent=2) + '\n')
    os.chmod(rollup_file, 0o600)
    try:
        account = pwd.getpwnam('goviral-archon')
        os.chown(rollup_file, account.pw_uid, account.pw_gid)
    except (KeyError, PermissionError):
        pass


def prune_old_rollups() -> int:
    """Remove rollups older than RETENTION_DAYS. Return count removed."""
    cutoff = datetime.now(timezone.utc).timestamp() - (RETENTION_DAYS * 86400)
    removed = 0
    try:
        for path in sorted(ANALYTICS_DIR.glob('*.json')):
            if path.stat().st_mtime < cutoff:
                path.unlink()
                removed += 1
    except OSError:
        pass
    return removed


def failed_units() -> list[str]:
    try:
        result = subprocess.run(
            ['/usr/bin/systemctl', 'list-units', '--state=failed',
             '--no-legend', '--no-pager', '--plain'],
            capture_output=True, text=True, check=False, timeout=15,
        )
        return [
            line.split()[0]
            for line in result.stdout.splitlines()
            if line.strip().startswith('goviral-')
        ]
    except Exception:
        return []


def backup_age_hours() -> float | None:
    try:
        target = (BACKUP_DIR / 'latest.tar.gz').resolve()
        return round((datetime.now(timezone.utc).timestamp() - target.stat().st_mtime) / 3600, 1)
    except OSError:
        return None


def main() -> None:
    health = load_json(HEALTH_FILE)
    queue = load_json(QUEUE_FILE)
    overview = api_get('/api/goviral/overview')

    checks = health.get('checks', [])
    critical = sum(1 for c in checks if c.get('status') == 'CRITICAL')
    warning = sum(1 for c in checks if c.get('status') == 'WARNING')

    rollup = {
        'generated_at': now(),
        'health_status': health.get('status', 'UNKNOWN'),
        'approval_pending': len(queue.get('pending', [])),
        'approval_approved': len(queue.get('approved', [])),
        'approval_rejected': len(queue.get('rejected', [])),
        'approval_executed': len(queue.get('executed', [])),
        'incident_critical': critical,
        'incident_warning': warning,
        'failed_units': failed_units(),
        'backup_age_hours': backup_age_hours(),
        'doctor_status': overview.get('doctor', {}).get('status', 'UNKNOWN'),
        'agent_threads': len(overview.get('recent_threads', [])),
    }

    save_rollup(rollup)
    pruned = prune_old_rollups()

    print(f'analytics_rollup=complete')
    print(f'health_status={rollup["health_status"]}')
    print(f'pending_approvals={rollup["approval_pending"]}')
    print(f'pruned_rollups={pruned}')


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print(f'analytics_rollup=error detail={str(exc)[:200]}', file=sys.stderr)
        raise SystemExit(1)
