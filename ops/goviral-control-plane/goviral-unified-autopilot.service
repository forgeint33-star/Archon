[Unit]
Description=GoViral Unified Autopilot Brain Orchestrator
After=network-online.target goviral-archon.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/goviral-archon/workspaces/goviral-brain
ExecStart=/usr/local/bin/goviral-unified-autopilot-guard run-all --write
User=root

# ── Hardening ────────────────────────────────────────────────────────────────
# Orchestrator timeout: 8 minutes (calls NL router which calls prompt+brain)
# Must be less than the timer interval to prevent accumulation
TimeoutStartSec=480

# Lower scheduling priority for batch work
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
