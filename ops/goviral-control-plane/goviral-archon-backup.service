[Unit]
Description=GoViral Archon secure backup
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/var/lib/goviral-archon
Environment=GIT_OPTIONAL_LOCKS=0
ExecStart=/usr/local/bin/goviral-archon-backup
# For Type=oneshot, only TimeoutStartSec acts as the execution bound.
TimeoutStartSec=900

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

ReadOnlyPaths=/opt/goviral-archon-src
ReadOnlyPaths=/var/lib/goviral-archon/.archon
ReadOnlyPaths=/var/lib/goviral-archon/workspaces/goviral-brain
ReadWritePaths=/var/lib/goviral-archon/backups/control-plane
